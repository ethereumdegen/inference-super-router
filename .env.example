# Server
PORT=8080
TEST_MODE=false
BASE_URL=https://your-domain.com

# Wallet & facilitator
BOT_WALLET_ADDRESS=0xYourWalletAddress
FACILITATOR_URL=https://facilitator.x402.org
FACILITATOR_SIGNER=0xFacilitatorSignerAddress

# USDC (x402 v2) settings
USDC_NETWORK=eip155:8453
USDC_TOKEN_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# Starkbot (x402 v1) settings
STARKBOT_NETWORK=base
STARKBOT_TOKEN_ADDRESS=0x587Cd533F418825521f3A1daa7CCd1E7339A1B07
STARKBOT_TOKEN_SYMBOL=STARKBOT
STARKBOT_TOKEN_DECIMALS=18
STARKBOT_TOKEN_NAME=StarkBot
STARKBOT_TOKEN_VERSION=1

# Settlement
SETTLEMENT_QUEUE_MAX_SIZE=10000
SETTLEMENT_DB_PATH=data/settlements.db

# Endpoints config
ENDPOINTS_CONFIG=endpoints.ron

# Credits system (ERC-8128, optional — omit to disable credits)
CREDITS_ADMIN_PRIVATE_KEY=your-hex-private-key
CREDITS_API_URL=https://starkbot.cloud
CREDITS_CHAIN_ID=8453

# Per-endpoint API keys (referenced by api_key_env in endpoints.ron)
KIMI_API_KEY=your-kimi-api-key
OPENAI_API_KEY=your-openai-api-key
MINIMAX_API_KEY=your-minimax-api-key
MORPHEUS_API_KEY=your-morpheus-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
