(
  endpoints: [
    (
      name: "kimi-k2.5",
      route_prefix: "/kimi",
      api_endpoint: "https://api.moonshot.ai/v1/chat/completions",
      api_key_env: "KIMI_API_KEY",
      model: "kimi-k2.5",
      archetype: "kimi",
      cost: "1000",
      payment_currency: "usdc",
      max_input_tokens: 50000,
      max_output_tokens: 50000,
      system_prompt_file: Some("prompts/kimi.md"),
      description: "Kimi K2.5 via x402",
    ),
    (
      name: "gpt-4.1-mini",
      route_prefix: "/openai-mini",
      api_endpoint: "https://api.openai.com/v1/chat/completions",
      api_key_env: "OPENAI_API_KEY",
      model: "gpt-4.1-mini",
      archetype: "openai",
      cost: "500",
      payment_currency: "usdc",
      max_input_tokens: 128000,
      max_output_tokens: 32000,
      system_prompt_file: None,
      description: "GPT-4.1 Mini via x402",
    ),
    (
      name: "minimax-01",
      route_prefix: "/minimax",
      api_endpoint: "https://api.minimax.chat/v1/text/chatcompletion_v2",
      api_key_env: "MINIMAX_API_KEY",
      model: "MiniMax-Text-01",
      archetype: "openai",
      cost: "50000",
      payment_currency: "starkbot",
      max_input_tokens: 1000000,
      max_output_tokens: 100000,
      system_prompt_file: None,
      description: "MiniMax-01 via x402",
    ),
  ],
)
